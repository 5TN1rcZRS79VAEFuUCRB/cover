#!/usr/bin/env python3
"""Synced lyrics for `cover`.
  cover-lyrics fetch <track> <out.lrc> [vocals.wav]
                                         look the song up on lrclib.net, save timed lyrics (with the song's
                                         isolated vocals, pick the version whose timing matches the singing)
  cover-lyrics show <file.lrc> <t0>      scroll them karaoke-style, t0 = epoch time the song started
  cover-lyrics time <name.txt> <vocals.wav>
                                         time plain lyrics against the song's isolated vocals -> <name>.lrc
  cover-lyrics sync <track>              tap Enter along with the song to turn plain lyrics into a timed .lrc
Only plain lyrics online -> fetch saves <name>.txt, cover times it once with `time` (or show prints it as a page),
sync redoes the timing by hand.
"""
import array, bisect, json, math, os, re, shlex, shutil, signal, subprocess, sys, textwrap, time, unicodedata, urllib.parse, urllib.request
from pathlib import Path


def probe(track, entry):
    return subprocess.run(["ffprobe", "-v", "error", "-show_entries", entry, "-of", "csv=p=0", track],
                          capture_output=True, text=True).stdout.strip()


def clean(s):
    return re.sub(r"\s*[(\[][^)\]]*[)\]]", "", s).strip()  # drop "(OFFICIAL)", "[HD]" etc.


def searches(artist, title, stem):
    """Queries to try, most trustworthy first: the tags as-is, then 'A - B' names split both ways round
    (files are named both 'Artist - Title' and 'Title - Artist'), then free text as a last resort."""
    tries = [{"artist_name": artist, "track_name": title}] if artist and title else []
    texts = [clean(t) for t in (title, stem) if t]
    for text in texts:
        parts = re.split(r"\s+[-–]\s+", text)
        if len(parts) >= 2:
            tries += [{"artist_name": parts[0], "track_name": parts[1]}, {"artist_name": parts[1], "track_name": parts[0]}]
    tries += [{"q": t} for t in texts]
    return [dict(t) for t in dict.fromkeys(tuple(t.items()) for t in tries)]  # dedupe, keep order


def stamped(lrc):
    """[(seconds, text)] of an .lrc, sorted; a line with several stamps is sung several times."""
    lines = []
    for raw in lrc.splitlines():
        text = re.sub(r"\[[^\]]*\]", "", raw).strip()
        lines += [(int(m) * 60 + float(s), text) for m, s in re.findall(r"\[(\d+):(\d+(?:\.\d+)?)\]", raw)]
    return sorted(lines)


def singing(vocals):
    """Whether the isolated vocal is singing, per quarter second: within 20 dB of its loud parts."""
    pcm = subprocess.run(["ffmpeg", "-v", "error", "-i", vocals, "-ac", "1", "-ar", "8000", "-f", "s16le", "-"],
                         capture_output=True).stdout
    a = array.array("h", pcm[:len(pcm) // 2 * 2])
    rms = [math.sqrt(sum(x * x for x in a[i:i + 2000]) / 2000) for i in range(0, len(a) - 1999, 2000)]
    loud = sorted(rms)[int(len(rms) * 0.95)] if rms else 0
    return [r > loud / 10 for r in rms]


def match(lrc, sung):
    """How well an .lrc's timing fits the singing (F1): a line counts as sung from its stamp to the next, at most 8 s."""
    lines = stamped(lrc)
    shown = [False] * len(sung)
    for (t, text), nxt in zip(lines, [t for t, _ in lines[1:]] + [math.inf]):
        if text:
            for k in range(int(t * 4), min(len(shown), int(min(nxt, t + 8) * 4))):
                shown[k] = True
    both = sum(a and b for a, b in zip(shown, sung))
    return 2 * both / max(1, sum(shown) + sum(sung))


def fetch(track, out, vocals=None):
    artist, title = probe(track, "format_tags=artist"), probe(track, "format_tags=title")
    duration = float(probe(track, "format=duration") or 0)
    ok, reached = [], False
    for params in searches(artist, title, Path(track).stem):  # all of them: lrclib often has several versions, some missing verses
        req = urllib.request.Request("https://lrclib.net/api/search?" + urllib.parse.urlencode(params),
                                     headers={"User-Agent": "cover-script (personal vocal cover recorder)"})
        try:
            results, reached = json.load(urllib.request.urlopen(req, timeout=10)), True
        except OSError:
            continue
        # same title can be many songs: a free-text hit only counts if the song length matches
        ok += [r for r in results if r.get("duration") and ("artist_name" in params or abs(r["duration"] - duration) <= 3)]
    if not reached:
        return print("Couldn't reach lrclib.net; recording without lyrics.")
    ok.sort(key=lambda r: abs(r["duration"] - duration))  # closest length = same recording, not a live version
    if vocals:
        sung = singing(vocals)  # better: the version whose lines start and stop when the band's singer does
        scores = {lrc: match(lrc, sung) for lrc in {r["syncedLyrics"] for r in ok if r.get("syncedLyrics")}}
        ok.sort(key=lambda r: -scores.get(r.get("syncedLyrics"), 0))  # stable: ties stay closest-length first
    out = Path(out); out.parent.mkdir(parents=True, exist_ok=True)
    for key, path in ("syncedLyrics", out), ("plainLyrics", out.with_suffix(".txt")):
        best = next((r for r in ok if r.get(key)), None)
        if best:
            path.write_text(best[key])
            print(f"Lyrics: {best['artistName']} - {best['trackName']} (saved to {path})")
            if key == "plainLyrics":
                print(f"They're untimed, so they'll show as a page. To make them scroll, run once:\n"
                      f"  cover-lyrics sync {shlex.quote(track)}")
            return
    print(f"No lyrics found. Put your own .lrc (timed) or .txt (plain) at {out.with_suffix('.*')} to add them.")


def screen():
    """The terminal itself, so lyrics show even while cover's output is captured (the TUI reads it for progress)."""
    try:
        return open("/dev/tty", "w")
    except OSError:
        return sys.stdout


def size(out):
    try:
        return os.get_terminal_size(out.fileno())
    except OSError:
        return shutil.get_terminal_size()


def show(lrc, t0):
    out = screen()
    lines = [(t, text or "♪") for t, text in stamped(Path(lrc).read_text())]
    if not lines:  # plain lyrics: no timing, so show the whole thing as columns that fit the terminal
        return print("\033[H\033[2J" + page(Path(lrc).read_text().splitlines(), *size(out), Path(lrc).stem), end="", flush=True, file=out)
    times = [t for t, _ in lines]
    dim, bold, yellow, reset = "\033[2m", "\033[1;97m", "\033[1;93m", "\033[0m"
    out.write("\033[?25l\033[2J")  # hide cursor while we draw
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(out.write("\033[?25h\033[0m") and out.flush()))  # cover stops us with TERM
    while True:  # redraw 20x/s so the countdown and bar move smoothly and resizes are picked up
        now = time.time() - t0
        width, height = size(out)
        i = bisect.bisect_right(times, now) - 1  # current line, -1 = intro
        start = times[i] if i >= 0 else 0.0
        cur = lines[i][1] if i >= 0 else "♪"
        nxt_t, nxt = lines[i + 1] if i + 1 < len(lines) else (None, "")
        rows = []  # (text, colour); every row gets centred

        def add(text, colour=""):
            rows.extend((part, colour) for part in textwrap.wrap(text, max(10, width - 4)) or [""])

        if cur == "♪" and nxt_t is not None:  # intro / instrumental break: count the vocals in
            wait = nxt_t - now
            w = math.ceil(wait)
            add(f"{w}" if wait <= 3 else f"♪   vocals in {w // 60}:{w % 60:02d}",
                yellow if wait <= 3 else dim)
            rows.append(("", ""))
            add(nxt, bold if wait <= 3 else "")
            later = [t for _, t in lines[i + 2:i + 4]]
        else:
            add(lines[i - 1][1] if i > 0 else "", dim)
            rows.append(("", ""))
            add(cur, bold)
            later = [t for _, t in lines[i + 1:i + 3]]
        if nxt_t is not None:  # bar fills up until the next line starts
            bw = min(40, width - 4)
            filled = int(bw * min(1, (now - start) / max(0.01, nxt_t - start)))
            rows += [("", ""), ("━" * filled + "─" * (bw - filled), yellow if nxt_t - now <= 1 else dim), ("", "")]
        for t in later:
            add(t, dim)
        top = max(0, (height - len(rows)) // 2)
        frame = "\n" * top + "\n".join(f"{c}{t.center(width).rstrip()}{reset}\033[K" for t, c in rows[:height])
        out.write("\033[H" + frame + "\033[J")
        out.flush()
        time.sleep(0.05)


def page(text, width, height, title=""):
    """Plain lyrics as one screen: verses kept whole, in the fewest balanced columns that fit, centred."""
    verses = [v.splitlines() for v in re.split(r"\n\s*\n", "\n".join(l.rstrip() for l in text).strip()) if v.strip()]
    room = max(1, height - 5)  # title + gap above, gap + footer below, one spare so nothing scrolls off the top
    verses = [v[i:i + room] for v in verses for i in range(0, len(v), room)]  # a verse taller than the screen gets split
    gap = 6

    def pack(cap):  # verses in order into columns at most cap rows tall, a blank row between verses
        cols = [[]]
        for v in verses:
            if cols[-1] and len(cols[-1]) + 1 + len(v) > cap:
                cols.append([])
            cols[-1] += ([""] if cols[-1] else []) + v
        return cols

    def wide(cols):
        return sum(max(map(len, c)) for c in cols) + gap * (len(cols) - 1)

    layouts = {}  # column count -> its most balanced (shortest) packing
    for cap in range(max(map(len, verses), default=1), room + 1):
        layouts.setdefault(len(pack(cap)), pack(cap))
    fit = [cols for _, cols in sorted(layouts.items()) if wide(cols) <= width]
    cols = fit[0] if fit else layouts[min(layouts)]
    while len(cols) > 1 and wide(cols) > width:  # too small for all of it: show what fits from the start
        cols = cols[:-1]
    w = [max(map(len, c)) for c in cols]
    left = " " * max(0, (width - wide(cols)) // 2)
    block = [left + (" " * gap).join(c[r].ljust(w[i]) if r < len(c) else " " * w[i] for i, c in enumerate(cols)).rstrip()
             for r in range(max(map(len, cols)))]
    note = ("untimed lyrics: to make them scroll, press l in the menu (or run cover-lyrics sync)" if fit else
            "too small for all the lyrics: enlarge the terminal, or time them so they scroll")
    rows = [f"\033[1;93m{title.center(width).rstrip()[:width]}\033[0m", ""] + \
           [f"\033[97m{b[:width]}\033[0m" for b in block] + ["", f"\033[2m{note.center(width).rstrip()[:width]}\033[0m"]
    return "\n" * max(0, (height - 1 - len(rows)) // 2) + "\n".join(rows)


def autotime(txt, vocals):
    """Time plain lyrics by forced alignment: torchaudio's MMS aligner finds where each known word is sung in the
    song's isolated vocal (demucs' stem). Kept only if the aligner is sure enough of the words; else the page stays."""
    try:
        import warnings; warnings.filterwarnings("ignore")  # torchaudio's deprecation notices
        import torch, torchaudio
        from torchaudio.pipelines import MMS_FA
    except ImportError:  # torch lives in demucs' own environment (uv tool / pipx): run there
        py = Path(shutil.which("demucs") or "demucs").resolve().parent / "python"
        if os.environ.get("COVER_IN_DEMUCS") or not py.exists():
            return print("Can't time the lyrics: needs demucs' torchaudio (see README). They'll show as a page.")
        return subprocess.call([str(py), os.path.realpath(__file__), "time", txt, vocals], env={**os.environ, "COVER_IN_DEMUCS": "1"})
    txt = Path(txt)
    lines = [l.strip() for l in txt.read_text().splitlines() if l.strip()]
    ascii_ = lambda l: unicodedata.normalize("NFKD", l).encode("ascii", "ignore").decode().lower()
    words = [re.sub(r"[^a-z']+", " ", ascii_(l)).split() for l in lines]  # the aligner knows a-z and ' only
    if not any(words):
        return print("No words in the lyrics to time.")
    print("Timing the lyrics to the record's vocals (once per song; the first time downloads a 1.2 GB model)...", flush=True)
    dev = "cuda" if torch.cuda.is_available() else "cpu"
    wav, sr = torchaudio.load(vocals)
    wav = torchaudio.functional.resample(wav.mean(0, keepdim=True), sr, MMS_FA.sample_rate).to(dev)
    model, step = MMS_FA.get_model().to(dev), 30 * MMS_FA.sample_rate
    with torch.inference_mode():  # 30 s at a time keeps memory flat on long songs
        em = torch.cat([model(wav[:, i:i + step])[0] for i in range(0, wav.size(1), step)], dim=1)
    flat = [w for ws in words for w in ws]
    try:
        spans = MMS_FA.get_aligner()(em[0], MMS_FA.get_tokenizer()(flat))
    except RuntimeError:  # more words than this recording can hold (lyrics of a longer version)
        return print("Couldn't time the lyrics: they don't fit this recording, so they'll show as a page.")
    sec, k, lrc = wav.size(1) / em.size(1) / MMS_FA.sample_rate, 0, ""
    for ws, line in zip(words, lines):
        t = spans[min(k, len(spans) - 1)][0].start * sec  # a line with no words (e.g. "666") takes the next word's time
        lrc += f"[{int(t // 60):02d}:{t % 60:05.2f}]{line}\n"
        k += len(ws)
    sure = sorted(s.score for ws in spans for s in ws)
    sure = sure[len(sure) // 2]  # median confidence per sound (letter)
    # ponytail: fixed bar from 8 songs: usable timing scored 0.07-0.2, a 35 s-off failure 0.026. Retried each take.
    if sure < 0.05:
        return print(f"Couldn't time the lyrics reliably (confidence {sure:.2f}), so they'll show as a page. "
                     f"To time them by hand: press l in the menu, or cover-lyrics sync.")
    txt.with_suffix(".lrc").write_text(lrc)  # the .txt stays: the menu's l re-times by hand from it
    print(f"Lyrics timed (confidence {sure:.2f}). If a line is off, fix its time in {txt.with_suffix('.lrc')}")


def sync(track):
    track = Path(track).resolve()
    txt = Path.home() / "covers/lyrics" / (track.stem + ".txt")
    lines = [l.strip() for l in txt.read_text().splitlines() if l.strip()]
    input(f"{len(lines)} lines from {txt}\nHeadphones on. Press Enter to start the song, "
          "then Enter the moment each line starts. Ctrl+C cancels.")
    player = subprocess.Popen(["pw-play", "--latency", "128", str(track)])
    t0, stamps = time.time(), []
    try:
        for i, line in enumerate(lines):
            nxt = lines[i + 1] if i + 1 < len(lines) else ""
            input(f"\033[H\033[2J\n  \033[1;97m{line}\033[0m\n\n  \033[2m{nxt}\033[0m\n\n  (Enter when this line starts)")
            stamps.append(max(0, time.time() - t0 - 0.2))  # ponytail: fixed 0.2s tap reaction; fix odd lines by hand in the .lrc
    finally:
        player.terminate()
    out = txt.with_suffix(".lrc")
    out.write_text("".join(f"[{int(t // 60):02d}:{t % 60:05.2f}]{l}\n" for t, l in zip(stamps, lines)))
    print(f"\nSaved {out}. Your next take of this song will scroll.")


def selftest():
    plain = lambda s: re.sub(r"\033\[[\d;]*m", "", s)
    three = "a1\na2\na3\n\nb1\nb2\nb3\n\nc1\nc2\nc3".splitlines()
    rows = [r.strip() for r in plain(page(three, 80, 30)).splitlines()]
    assert "\n".join(rows).strip().split("\n\n")[:3] == ["a1\na2\na3", "b1\nb2\nb3", "c1\nc2\nc3"], \
        "room for one column: one column, verses still separated"
    rows = [r.strip() for r in plain(page(three, 80, 9)).splitlines()]   # 4 rows of room: one verse per column
    assert ["a1      b1      c1", "a2      b2      c2", "a3      b3      c3"] == [r for r in rows if r.startswith("a")], \
        "verses kept whole, side by side, in order"
    long = [l and l + "-" * 50 for l in three]   # 3 verses side by side need ~170 columns
    assert "too small" in page(long, 100, 9) and "c1" not in page(long, 100, 9), "doesn't fit: shows the start, says so"
    print("selftest ok")


if __name__ == "__main__":
    if sys.argv[1:] == ["--selftest"]:
        sys.exit(selftest())
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        sys.exit(print(__doc__.strip()))
    {"fetch": fetch, "show": lambda f, t0: show(f, float(t0)), "time": autotime, "sync": sync}[sys.argv[1]](*sys.argv[2:])
